---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import logo from '../assets/logo-mark.png';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href === path;
---

<header class="sticky top-0 z-40 border-b border-line bg-ink/70 backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6" aria-label="Main">
    <a href="/" class="flex items-center gap-3 font-display text-lg font-bold tracking-tight">
      <Image src={logo} alt="" width={40} height={40} densities={[1, 2]} class="size-10 mix-blend-lighten" loading="eager" />
      <span class="text-chrome-metal">TruTime</span> <span class="text-gold">Media</span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-8 md:flex">
      {site.nav.map(({ label, href }) => (
        <li>
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class="text-sm transition-colors hover:text-chrome aria-[current=page]:text-gold"
          >
            {label}
          </a>
        </li>
      ))}
      <li>
        <a href="/contact" class="rounded-full bg-gold px-5 py-2 text-sm font-semibold text-ink transition hover:bg-chrome">
          Get a quote
        </a>
      </li>
    </ul>

    <!-- Mobile menu: native <details>, so it works with zero JavaScript -->
    <details class="group relative md:hidden">
      <summary class="flex size-10 cursor-pointer list-none items-center justify-center rounded-lg border border-line [&::-webkit-details-marker]:hidden" aria-label="Menu">
        <svg class="size-5 text-chrome group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg class="hidden size-5 text-chrome group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </summary>
      <ul class="glass absolute right-0 mt-3 w-56 rounded-2xl p-2 shadow-2xl">
        {site.nav.map(({ label, href }) => (
          <li>
            <a
              href={href}
              aria-current={isActive(href) ? 'page' : undefined}
              class="block rounded-xl px-4 py-3 hover:bg-white/5 hover:text-chrome aria-[current=page]:text-gold"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
</header>
