---
import Base from '../layouts/Base.astro';
---

<Base>
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-gold">El Paso, TX</p>
    <h1 class="mt-4 text-5xl font-bold sm:text-7xl">
      <span class="text-chrome-metal">Websites built</span><br /><span class="text-gold-metal">on TruTime.</span>
    </h1>
    <p class="mt-6 max-w-xl">Phase 1 placeholder: theme, layout, nav and footer. The real hero arrives in phase 2.</p>
    <div class="glass mt-10 max-w-sm rounded-2xl p-6">
      <h2 class="text-xl font-semibold">Glass card</h2>
      <p class="mt-2 text-sm">Preview of the reusable surface style.</p>
    </div>
  </section>
</Base>
