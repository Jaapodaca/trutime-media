---
import Icon from './Icon.astro';

interface Props {
  icon: string;
  title: string;
  text: string;
}
const { icon, title, text } = Astro.props;
---

<article class="glass group relative overflow-hidden rounded-2xl p-8 transition-[translate,border-color] duration-300 hover:-translate-y-1 hover:border-gold/40" data-reveal>
  <!-- gold glow that fades in on hover -->
  <div class="pointer-events-none absolute -top-24 -right-24 size-48 rounded-full bg-gold/20 opacity-0 blur-3xl transition group-hover:opacity-100"></div>
  <div class="flex size-12 items-center justify-center rounded-xl border border-gold/30 bg-gold/10 text-gold">
    <Icon name={icon} />
  </div>
  <h3 class="mt-6 text-xl font-semibold">{title}</h3>
  <p class="mt-3">{text}</p>
</article>
