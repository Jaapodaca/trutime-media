---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  id?: string;
}
const { eyebrow, title, intro, id } = Astro.props;
---

<section id={id} class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
  <div class="max-w-2xl" data-reveal>
    {eyebrow && <p class="text-sm font-semibold uppercase tracking-[0.3em] text-gold">{eyebrow}</p>}
    <h2 class="mt-3 text-3xl font-bold sm:text-5xl">{title}</h2>
    {intro && <p class="mt-4 text-lg">{intro}</p>}
  </div>
  <div class="mt-12">
    <slot />
  </div>
</section>
