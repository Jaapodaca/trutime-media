---
import Button from './Button.astro';

interface Props {
  name: string;
  tag: string;
  text: string;
  features: string[];
  featured?: boolean;
  cta?: string;
}
const { name, tag, text, features, featured = false, cta = 'Get a custom quote' } = Astro.props;
---

<article
  class:list={[
    'relative flex flex-col rounded-3xl p-8 sm:p-10',
    featured ? 'border border-gold/50 bg-panel shadow-[0_0_60px_-20px] shadow-gold/40' : 'glass',
  ]}
  data-reveal
>
  <p class:list={['w-fit rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-widest', featured ? 'bg-gold text-ink' : 'border border-line text-chrome']}>
    {tag}
  </p>
  <h3 class="mt-6 text-3xl font-bold">{name}</h3>
  <p class="mt-3">{text}</p>
  <ul class="mt-8 flex-1 space-y-3">
    {features.map((f) => (
      <li class="flex gap-3">
        <svg class="mt-0.5 size-5 shrink-0 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
        <span class="text-chrome">{f}</span>
      </li>
    ))}
  </ul>
  <Button href="/contact" variant={featured ? 'primary' : 'ghost'} class="mt-10 w-full">{cta}</Button>
</article>
